# Box OAuth 2.0 (User Authentication) — copy to .env and fill in. DO NOT COMMIT .env
# Client ID (not secret-sensitive)
BOX_CLIENT_ID=
# Client Secret — sensitive. Paste only here in .env, never in chat or code.
BOX_CLIENT_SECRET=
# Must match the redirect URI registered in the Box Developer Console
BOX_REDIRECT_URI=http://localhost:3000/callback
# Proxy port that performs the code->token exchange
PROXY_PORT=4000
# Optional: root folder name created in Box
BOX_ROOT_FOLDER_NAME=Northstar ClaimIQ
