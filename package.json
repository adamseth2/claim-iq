{
  "name": "claimiq-recovery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n app,proxy -c cyan,magenta \"vite\" \"node --env-file=.env server/proxy.mjs\"",
    "dev:app": "vite",
    "dev:proxy": "node --env-file=.env server/proxy.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "box:verify": "node --env-file=.env server/box-verify.mjs",
    "box:seed": "node --env-file=.env server/box-seed.mjs",
    "seed:docs": "node server/seed/generate.mjs",
    "box:assets": "node server/box-assets-gen.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.1",
    "@types/node": "20.14.15",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "express": "4.19.2",
    "jsdom": "24.1.1",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "vitest": "2.0.5"
  }
}
